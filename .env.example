# Copy to .env (git-ignored) and fill in.

# "sim" = built-in simulator (no robot), "agent" = the real TurtleBot via robot_agent/agent.py
ROBOT_BACKEND=sim
ROBOT_AGENT_URL=http://192.168.137.140:8765
# Same value as AGENT_TOKEN in ~/.turtlebot_agent_env on the robot (at least 16 characters).
ROBOT_AGENT_TOKEN=

# Seconds per simulated motion
ROBOT_SIM_DELAY=1.0

# Where pictures are stored (default: ./archive)
# ARCHIVE_DIR=D:\turtlebot-archive

# DJANGO_DEBUG=1
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
